# Django deployment environment variables

# Security
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 your-production-domain.com

# CORS / CSRF
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173 https://your-frontend-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173 https://your-frontend-domain.com

# Email configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@vamshieducare.com
